---
import { site } from '../data/site.ts';

/**
 * Sticky bottom bar, mobile only.
 *
 * The three things a hungry person on a phone actually wants — call,
 * directions, menu — pinned within thumb reach on every page, so they are
 * never more than one tap away regardless of scroll position.
 * Hidden on desktop, where the header already carries the phone number.
 */
---

<div class="actionBar">
  <a class="actionBar__item" href={`tel:${site.phone.href}`}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"></path>
    </svg>
    <span>Call</span>
  </a>

  <a class="actionBar__item" href={site.links.directions} target="_blank" rel="noopener">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
      <circle cx="12" cy="10" r="3"></circle>
    </svg>
    <span>Directions</span>
  </a>

  <a class="actionBar__item" href="/menu">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M4 3h13a2 2 0 0 1 2 2v16l-7-3-7 3V3z"></path>
      <path d="M8 8h7M8 12h7"></path>
    </svg>
    <span>Menu</span>
  </a>
</div>

<style>
  .actionBar {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 90;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    background: var(--paper);
    border-top: 1px solid var(--sand);
    box-shadow: 0 -2px 16px rgb(58 49 40 / 0.1);
    /* Clear the iPhone home indicator. */
    padding-bottom: env(safe-area-inset-bottom, 0);
  }

  .actionBar__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    min-height: 3.5rem;
    padding-block: var(--space-2xs);
    color: var(--navy);
    text-decoration: none;
    font-size: var(--step--1);
    font-weight: 600;
  }

  .actionBar__item + .actionBar__item {
    border-inline-start: 1px solid var(--sand);
  }

  .actionBar__item svg {
    width: 22px;
    height: 22px;
  }

  .actionBar__item:active {
    background: var(--sand);
  }

  @media (min-width: 48rem) {
    .actionBar {
      display: none;
    }
  }
</style>
