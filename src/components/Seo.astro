---
import { getImage } from 'astro:assets';
import storefront from '../assets/place/storefront.jpg';
import { site, schemaOpeningHours } from '../data/site.ts';

interface Props {
  title: string;
  description: string;
  /** Set on the homepage so the title isn't "Blue Heron | Blue Heron". */
  isHome?: boolean;
}

const { title, description, isHome = false } = Astro.props;

const pageTitle = isHome
  ? `${site.name} — ${site.tagline} in ${site.neighborhood}, Seattle`
  : `${title} | ${site.name}`;

const canonical = new URL(Astro.url.pathname, Astro.site).href;

// Open Graph images must be absolute URLs with real dimensions, so this
// generates a properly sized social card from the storefront photo rather
// than linking the 3.5MB original.
const og = await getImage({
  src: storefront,
  width: 1200,
  height: 630,
  fit: 'cover',
  position: 'center',
  format: 'jpeg',
  // Without this, the project-wide `constrained` layout makes getImage
  // generate a full responsive srcset — eight JPEGs — when a social card
  // only ever needs the single 1200x630 file.
  layout: 'none',
});
const ogUrl = new URL(og.src, Astro.site).href;

/**
 * Restaurant structured data.
 *
 * This is what lets Google show the hours, price range, phone number and
 * menu link directly in search results. For a neighborhood spot where
 * essentially every customer arrives via a phone search, this markup is
 * worth more than any visual change on the site.
 */
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  '@id': `${site.url}/#restaurant`,
  name: site.legalName,
  alternateName: site.name,
  description: site.shortDescription,
  url: site.url,
  telephone: site.phone.display,
  priceRange: site.priceRange,
  servesCuisine: ['Sandwiches', 'Coffee', 'Soup', 'Breakfast'],
  foundingDate: String(site.founded),
  founder: { '@type': 'Person', name: site.owner },
  image: ogUrl,
  hasMenu: `${site.url}/menu`,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.city,
    addressRegion: site.address.region,
    postalCode: site.address.postalCode,
    addressCountry: site.address.country,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: site.geo.latitude,
    longitude: site.geo.longitude,
  },
  openingHours: schemaOpeningHours(),
  hasDriveThroughService: site.features.driveThru,
  acceptsReservations: false,
  takeaway: site.features.takeout,
  servesDineIn: site.features.dineIn,
  sameAs: [site.links.yelp],
};
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.legalName} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta
  property="og:image:alt"
  content="The Blue Heron storefront on Gilman Ave W in Magnolia, Seattle"
/>
<meta property="og:locale" content="en_US" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogUrl} />

<meta name="geo.region" content="US-WA" />
<meta name="geo.placename" content={`${site.neighborhood}, Seattle`} />
<meta name="theme-color" content="#17335A" />

<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify(schema)}
/>
